---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title?: string; description?: string; }
const { title = site.name, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} · {site.role}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">Ehsan</a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/apps/">Apps</a>
          <a href="/projects/">Projects</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} Ehsan</span>
        <span><a href={site.github}>GitHub</a> · <a href={site.email}>Email</a></span>
      </div>
    </footer>
  </body>
</html>
