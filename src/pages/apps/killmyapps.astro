---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apps } from '../../data/site';
const app = apps.find((item) => item.slug === 'killmyapps')!;
---
<BaseLayout title="KillMyApps">
  <div class="container page">
    <p><a href="/apps/">← Apps</a></p>
    <header class="page-header">
      <span class="eyebrow">Android · Open Source</span>
      <h1>{app.name}</h1>
      <p>{app.tagline}</p>
      <div class="actions"><a class="button primary" href={app.download}>Download</a><a class="button" href={app.github}>View on GitHub</a></div>
    </header>

    <section class="section prose">
      <h2>What it does</h2>
      <p>{app.description}</p>
      <p>KillMyApps is built for Android power users who want a fast, direct way to stop apps without turning the tool into a full app manager.</p>
    </section>

    <section class="section">
      <span class="eyebrow">Core features</span>
      <h2>Focused by design.</h2>
      <div class="grid">
        <article class="card"><h3>One-tap kill</h3><p>Quickly terminate selected apps with minimal friction.</p></article>
        <article class="card"><h3>Root & Shizuku</h3><p>Choose the execution path that fits your device and setup.</p></article>
        <article class="card"><h3>Selection Mode</h3><p>Select exactly the apps you want to work with.</p></article>
        <article class="card"><h3>Quick access</h3><p>Use system surfaces such as Quick Settings and widgets for faster access.</p></article>
      </div>
    </section>

    <section class="section prose">
      <h2>Why this project</h2>
      <p>The goal is simple: make app termination fast, predictable, and unobtrusive. No unnecessary dashboard, no bloated management layer—just a focused Android utility.</p>
    </section>
  </div>
</BaseLayout>
