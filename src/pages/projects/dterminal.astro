---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectDetails, projects } from '../../data/site';
const project = projects.find((item) => item.slug === 'dterminal')!;
const detail = projectDetails.dterminal;
---
<BaseLayout title="DTerminal" description={detail.summary}>
  <div class="container page">
    <p><a class="back-link" href="/projects/">← Projects</a></p>
    <header class="page-header project-detail-header"><span class="eyebrow">{detail.eyebrow}</span><h1>{detail.title}</h1><p>{detail.summary}</p><div class="actions"><a class="button primary" href={project.github}>View on GitHub</a></div></header>
    <section class="detail-intro"><div class="detail-stat"><strong>Android</strong><span>Platform</span></div><div class="detail-stat"><strong>Python 3.13</strong><span>Embedded runtime</span></div><div class="detail-stat"><strong>Clean + MVI</strong><span>Architecture</span></div></section>
    <section class="section prose"><span class="eyebrow">Overview</span><h2>A terminal for Android.</h2><p>{detail.overview}</p></section>
    <section class="section prose"><span class="eyebrow">The problem</span><h2>Shell access and scripting in one place.</h2><p>{detail.problem}</p></section>
    <section class="section"><span class="eyebrow">Approach</span><h2>The main building blocks.</h2><div class="grid">{detail.approach.map(([title, text]) => <article class="card"><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="section prose"><span class="eyebrow">Architecture</span><h2>Separating state from execution.</h2><p>{detail.architecture}</p></section>
    <section class="section prose"><span class="eyebrow">System integration</span><h2>Working with the shell.</h2><p>{detail.system}</p></section>
    <section class="section prose"><span class="eyebrow">Design decisions</span><h2>Built for Android rather than a desktop terminal.</h2><p>The project treats Android as its native environment. Persistent state, touch controls, runtime management, and asynchronous execution are designed around the constraints of a mobile device.</p></section>
    <section class="section prose"><span class="eyebrow">What's next</span><h2>Further runtime work.</h2><p>{detail.next}</p></section>
    <section class="section"><div class="actions"><a class="button primary" href={project.github}>Explore the source</a><a class="button" href="/projects/">Back to projects</a></div></section>
  </div>
</BaseLayout>
