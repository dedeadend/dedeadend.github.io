---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectDetails, projects } from '../../data/site';
const project = projects.find((item) => item.slug === 'dterminal')!;
const detail = projectDetails.dterminal;
---
<BaseLayout title="DTerminal" description={detail.summary}>
  <div class="container page">
    <p><a class="back-link" href="/projects/">← Projects</a></p>
    <header class="page-header project-detail-header"><span class="eyebrow">{detail.eyebrow}</span><h1>{detail.title}</h1><p>{detail.summary}</p><div class="actions"><a class="button primary" href={project.github}>View on GitHub</a></div></header>
    <figure class="project-banner"><img src="https://raw.githubusercontent.com/dedeadend/DTerminal/main/screenshots/DTerminalBanner.png" alt="DTerminal banner" loading="eager" /></figure>
    <section class="detail-intro"><div class="detail-stat"><strong>{detail.version}</strong><span>Version</span></div><div class="detail-stat"><strong>Android 11+</strong><span>Minimum version</span></div><div class="detail-stat"><strong>Python 3.13</strong><span>Embedded runtime</span></div><div class="detail-stat"><strong>Clean + MVI</strong><span>Architecture</span></div></section>
    <section class="section prose"><span class="eyebrow">Overview</span><h2>A terminal built for Android.</h2><p>{detail.overview}</p></section>
    <section class="section prose"><span class="eyebrow">Why it exists</span><h2>Shell and scripting without a separate setup.</h2><p>{detail.problem}</p></section>
    <section class="section"><span class="eyebrow">Implementation</span><h2>The pieces behind the workflow.</h2><div class="grid">{detail.approach.map(([title, text]) => <article class="card"><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="section prose"><span class="eyebrow">Architecture</span><h2>State and execution stay separate.</h2><p>{detail.architecture}</p></section>
    <section class="section prose"><span class="eyebrow">System integration</span><h2>Working with the Android shell.</h2><p>{detail.system}</p></section>
    <section class="section screenshots-section"><span class="eyebrow">Screenshots</span><h2>Terminal, scripts, and history.</h2><div class="screenshot-grid"><figure><img src="https://raw.githubusercontent.com/dedeadend/DTerminal/main/screenshots/DTerminalScript.png" alt="DTerminal script workspace" loading="lazy" /></figure><figure><img src="https://raw.githubusercontent.com/dedeadend/DTerminal/main/screenshots/DTerminalHistory.png" alt="DTerminal command history" loading="lazy" /></figure></div></section>
    <section class="section prose"><span class="eyebrow">Design decision</span><h2>Use Android as the environment.</h2><p>The application treats touch input, lifecycle, persistent state, runtime management, and asynchronous execution as first-class Android concerns rather than adapting a desktop terminal model to a smaller screen.</p></section>
    <section class="section"><span class="eyebrow">Release history</span><h2>Version history.</h2><div class="release-list">{detail.releaseHistory.map(([version, text]) => <div><strong>{version}</strong><span>{text}</span></div>)}</div></section>
  </div>
</BaseLayout>
