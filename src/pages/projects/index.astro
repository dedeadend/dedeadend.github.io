---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site';
---
<BaseLayout title="Projects">
  <div class="container page">
    <header class="page-header"><span class="eyebrow">Projects · {projects.length}</span><h1>Things I build.</h1><p>Android applications, system tools, and projects that explore different parts of the platform.</p></header>
    <div class="grid project-list">
      {projects.map((project) => <a class="card project-card" href={project.href}>
        <div class="project-card-visual">
          {project.slug === 'killmyapps' && <svg class="project-icon" viewBox="0 0 108 108" role="img" aria-label="KillMyApps icon">
            <rect width="108" height="108" rx="24" fill="#C0185A"/>
            <g transform="translate(24.3 24.3) scale(0.55)" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
              <circle cx="12" cy="12" r="2.2"/>
              <g transform="rotate(30 12 12)"><path d="M12 9.5V4.5"/><path d="M9.5 2 12 4.5 14.5 2"/></g>
              <g transform="rotate(90 12 12)"><path d="M12 9.5V4.5"/><path d="M9.5 2 12 4.5 14.5 2"/></g>
              <g transform="rotate(150 12 12)"><path d="M12 9.5V4.5"/><path d="M9.5 2 12 4.5 14.5 2"/></g>
              <g transform="rotate(210 12 12)"><path d="M12 9.5V4.5"/><path d="M9.5 2 12 4.5 14.5 2"/></g>
              <g transform="rotate(270 12 12)"><path d="M12 9.5V4.5"/><path d="M9.5 2 12 4.5 14.5 2"/></g>
              <g transform="rotate(330 12 12)"><path d="M12 9.5V4.5"/><path d="M9.5 2 12 4.5 14.5 2"/></g>
            </g>
          </svg>}
          {project.slug === 'dterminal' && <img class="project-icon" src="https://raw.githubusercontent.com/dedeadend/DTerminal/main/app/src/main/ic_launcher-playstore.png" alt="DTerminal icon" loading="lazy" />}
          {project.slug === 'evilfont' && <span class="project-icon project-icon-crop" role="img" aria-label="EvilFont icon"></span>}
        </div>
        <div class="project-card-content">
          <div class="project-card-top"><span class="eyebrow">{project.category}</span><span class="status"><span class="status-dot"></span>{project.status}</span></div>
          <h2>{project.name}</h2><p>{project.description}</p>
          <div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          <div class="project-link">View details →</div>
        </div>
      </a>)}
    </div>
    <section class="section split-section">
      <div><span class="eyebrow">Engineering focus</span><h2>Working close to the platform.</h2></div>
      <div class="prose"><p>These projects cover areas I spend time on: Android UI and architecture, system-level access, Root and Shizuku integration, native tooling, automation, and performance.</p><p>I tend to prefer smaller tools where the architecture supports the product rather than becoming a goal by itself.</p></div>
    </section>
    <section class="section split-section">
      <div><span class="eyebrow">Across the stack</span><h2>Application to system.</h2></div>
      <div class="prose"><p>Depending on the project, I work with Kotlin and Compose at the application layer, or C/C++, Python, Bash, Root modules, and Android system interfaces when deeper access is needed.</p></div>
    </section>
  </div>
</BaseLayout>
