---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site';
---
<BaseLayout title="Projects">
  <div class="container page">
    <header class="page-header"><span class="eyebrow">Projects</span><h1>Things I build.</h1><p>Android projects, experiments, and focused tools.</p></header>
    <div class="grid">{projects.map((project) => <a class="card" href={project.href}><h3>{project.name}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></a>)}</div>
  </div>
</BaseLayout>
