---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/site';
---
<BaseLayout title="Projects">
  <div class="container page">
    <header class="page-header"><span class="eyebrow">Selected work</span><h1>Things I build.</h1><p>Android software, system tools, and experiments built around useful results, direct control, and maintainable engineering.</p></header>
    <div class="grid project-list">
      {projects.map((project) => <a class="card project-card" href={project.href}>
        <div class="project-card-top"><span class="eyebrow">{project.category}</span><span class="status">● {project.status}</span></div>
        <h2>{project.name}</h2><p>{project.description}</p>
        <div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        <div class="project-link">View project →</div>
      </a>)}
    </div>
    <section class="section prose"><span class="eyebrow">Engineering focus</span><h2>Close to the platform.</h2><p>These projects reflect the areas I spend the most time in: modern Android UI and architecture, system-level access, Root and Shizuku integration, native tooling, automation, and performance-focused software.</p></section>
  </div>
</BaseLayout>
