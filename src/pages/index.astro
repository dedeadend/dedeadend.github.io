---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps, projects, site } from '../data/site';
const featuredApp = apps.find((app) => app.featured) ?? apps[0];
const featuredProject = projects.find((project) => project.featured) ?? projects[0];
---
<BaseLayout title="DeDeadend">
  <div class="container">
    <section class="hero home-hero">
      <div class="hero-copy">
        <span class="eyebrow">Android Software Engineer</span>
        <h1>Ehsan Nasiri.</h1>
        <p class="lead">Android engineer working across application code, system interfaces, and device-level tooling.</p>
        <div class="actions"><a class="button primary" href="/projects/">View projects</a><a class="button" href="/about/">About me</a></div>
      </div>
    </section>

    {featuredProject && featuredApp && <section class="section">
      <div class="section-head featured-head"><div><span class="eyebrow">Featured project</span><h2>{featuredProject.name}</h2></div><a class="text-link" href="/projects/">All projects →</a></div>
      <div class="featured">
        <article class="card"><h3>{featuredApp.tagline}</h3><p>{featuredApp.description}</p><div class="tags">{featuredApp.tags.map((tag) => <span class="tag">{tag}</span>)}</div><div class="actions"><a class="button primary" href={featuredProject.href}>View project</a><a class="button" href={featuredApp.github}>Source</a></div></article>
        <div class="meta"><div class="meta-row"><span>Version</span><strong>{featuredApp.version}</strong></div><div class="meta-row"><span>Access</span><strong>Root / Shizuku</strong></div><div class="meta-row"><span>Minimum Android</span><strong>{featuredApp.minAndroid}</strong></div><div class="meta-row"><span>License</span><strong>{featuredApp.license}</strong></div></div>
      </div>
    </section>}

    <section class="section split-section">
      <div><span class="eyebrow">Focus</span><h2>Android, from application to system.</h2></div>
      <div class="prose"><p>{site.bio}</p><p>Kotlin and Java are my main application languages; I also work with C/C++, Python, Bash, the Android SDK/NDK, Root, and Shizuku when the implementation calls for them.</p><a class="text-link" href="/about/">More about me →</a></div>
    </section>
  </div>
</BaseLayout>
