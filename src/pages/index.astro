---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps, projects } from '../data/site';
const featured = apps.find((app) => app.featured) ?? apps[0];
---
<BaseLayout title="Ehsan">
  <div class="container">
    <section class="hero">
      <span class="eyebrow">Android Developer</span>
      <h1>I build small, useful Android tools.</h1>
      <p class="lead">Focused on system-level Android, performance, control, and clean product design.</p>
      <div class="actions">
        <a class="button primary" href="/apps/">Explore apps</a>
        <a class="button" href="https://github.com/dedeadend">GitHub</a>
      </div>
    </section>

    {featured && <section class="section">
      <div class="section-head"><div><span class="eyebrow">Featured app</span><h2>{featured.name}</h2></div><p>{featured.status}</p></div>
      <div class="featured">
        <article class="card">
          <h3>{featured.tagline}</h3>
          <p>{featured.description}</p>
          <div class="tags">{featured.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          <div class="actions"><a class="button primary" href={`/apps/${featured.slug}/`}>View app</a><a class="button" href={featured.github}>Source</a></div>
        </article>
        <div class="meta">
          <div class="meta-row"><span>Version</span><strong>{featured.version}</strong></div>
          <div class="meta-row"><span>Access</span><strong>Root / Shizuku</strong></div>
          <div class="meta-row"><span>Status</span><strong>{featured.status}</strong></div>
        </div>
      </div>
    </section>}

    <section class="section">
      <div class="section-head"><div><span class="eyebrow">Selected work</span><h2>Projects</h2></div><a href="/projects/">View all</a></div>
      <div class="grid">{projects.map((project) => <a class="card" href={project.href}><h3>{project.name}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></a>)}</div>
    </section>
  </div>
</BaseLayout>
