---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about, apps, projects, site } from '../data/site';
const featuredApp = apps.find((app) => app.featured) ?? apps[0];
const featuredProject = projects.find((project) => project.featured) ?? projects[0];
---
<BaseLayout title="DeDeadend">
  <div class="container">
    <section class="hero home-hero">
      <div class="hero-copy">
        <span class="eyebrow">Android Software Engineer</span>
        <h1>Ehsan Nasiri.<br /><span class="muted-heading">DeDeadend.</span></h1>
        <p class="lead">I build Android software close to the system, with a focus on performance, control, and practical tools.</p>
        <div class="actions"><a class="button primary" href="/projects/">View projects</a><a class="button" href="/about/">About me</a></div>
      </div>
      <div class="hero-profile">
        <img src={site.avatar} alt="Ehsan Nasiri" />
        <div class="profile-caption"><strong>{about.years}</strong><span>Android experience</span></div>
      </div>
    </section>

    {featuredProject && featuredApp && <section class="section">
      <div class="section-head"><div><span class="eyebrow">Featured project</span><h2>{featuredProject.name}</h2></div><p>{featuredApp.status}</p></div>
      <div class="featured">
        <article class="card">
          <h3>{featuredApp.tagline}</h3>
          <p>{featuredApp.description}</p>
          <div class="tags">{featuredApp.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          <div class="actions"><a class="button primary" href={featuredProject.href}>View project</a><a class="button" href={featuredApp.github}>Source</a></div>
        </article>
        <div class="meta">
          <div class="meta-row"><span>Version</span><strong>{featuredApp.version}</strong></div>
          <div class="meta-row"><span>Access</span><strong>Root / Shizuku</strong></div>
          <div class="meta-row"><span>Minimum Android</span><strong>{featuredApp.minAndroid}</strong></div>
          <div class="meta-row"><span>License</span><strong>{featuredApp.license}</strong></div>
        </div>
      </div>
    </section>}

    <section class="section">
      <div class="section-head"><div><span class="eyebrow">Selected work</span><h2>Built across the stack.</h2></div><a class="text-link" href="/projects/">All projects →</a></div>
      <div class="grid">{projects.map((project) => <a class="card project-card" href={project.href}><span class="eyebrow">{project.category}</span><h3>{project.name}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></a>)}</div>
    </section>

    <section class="section split-section">
      <div><span class="eyebrow">Focus</span><h2>System-minded Android.</h2></div>
      <div class="prose"><p>{site.bio}</p><p>My toolkit spans Kotlin and Java through C/C++, Python, Bash, the Android SDK/NDK, Root, Shizuku, and modern Android architecture.</p><a class="text-link" href="/about/">More about me →</a></div>
    </section>
  </div>
</BaseLayout>
