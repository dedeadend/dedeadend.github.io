---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps, projects } from '../data/site';
const featuredApp = apps.find((app) => app.featured) ?? apps[0];
const featuredProject = projects.find((project) => project.featured) ?? projects[0];
---
<BaseLayout title="Ehsan">
  <div class="container">
    <section class="hero">
      <span class="eyebrow">Android Software Engineer</span>
      <h1>I build Android software close to the system.</h1>
      <p class="lead">Focused on system-level Android, performance, control, and practical tools.</p>
      <div class="actions">
        <a class="button primary" href="/projects/">View projects</a>
        <a class="button" href="https://github.com/dedeadend">GitHub</a>
      </div>
    </section>

    {featuredProject && featuredApp && <section class="section">
      <div class="section-head"><div><span class="eyebrow">Featured project</span><h2>{featuredProject.name}</h2></div><p>{featuredApp.status}</p></div>
      <div class="featured">
        <article class="card">
          <h3>{featuredApp.tagline}</h3>
          <p>{featuredApp.description}</p>
          <div class="tags">{featuredApp.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          <div class="actions"><a class="button primary" href={featuredProject.href}>View project</a><a class="button" href={featuredApp.github}>Source</a></div>
        </article>
        <div class="meta">
          <div class="meta-row"><span>Version</span><strong>{featuredApp.version}</strong></div>
          <div class="meta-row"><span>Access</span><strong>Root / Shizuku</strong></div>
          <div class="meta-row"><span>Status</span><strong>{featuredApp.status}</strong></div>
        </div>
      </div>
    </section>}
  </div>
</BaseLayout>
