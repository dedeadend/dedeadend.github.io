---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about, experience, site } from '../data/site';
---
<BaseLayout title="About">
  <div class="container page">
    <header class="page-header about-header">
      <span class="eyebrow">About · {about.years}</span>
      <h1>Ehsan Nasiri</h1>
      <p>{about.title}</p>
    </header>

    <section class="section prose">
      <span class="eyebrow">About me</span><h2>Android application and system work.</h2>
      <p>{site.bio}</p>
      <p>My projects range from application development and UI work to system-facing features such as Root access, Shizuku integration, background execution, device customization, and performance tuning.</p>
      <p>I value clear boundaries in code, predictable behavior, and solutions that stay proportional to the problem they are meant to solve.</p>
    </section>

    <section class="section">
      <span class="eyebrow">Experience & activities</span><h2>Selected work and projects.</h2>
      <div class="timeline">{experience.map((item) => <article class="timeline-item"><div class="timeline-dot"></div><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
    </section>

    <section class="section skills-section">
      <div><span class="eyebrow">Programming</span><h2>Languages.</h2><div class="tags">{about.programming.map((item) => <span class="tag">{item}</span>)}</div></div>
      <div><span class="eyebrow">Android development</span><h2>Platform & UI.</h2><div class="tags">{about.android.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section skills-section">
      <div><span class="eyebrow">Architecture & concurrency</span><h2>Application structure.</h2><div class="tags">{about.architecture.map((item) => <span class="tag">{item}</span>)}</div></div>
      <div><span class="eyebrow">Data & tools</span><h2>Development stack.</h2><div class="tags">{about.data.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section">
      <div class="skills-section system-skills"><div><span class="eyebrow">System & performance</span><h2>Platform-level work.</h2></div><div class="tags">{about.system.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section contact-section">
      <span class="eyebrow">Connect</span><h2>DeDeadend</h2>
      <p class="contact-email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="actions"><a class="button primary" href={site.telegram}>Telegram</a><a class="button" href={site.github}>GitHub</a></div>
    </section>
  </div>
</BaseLayout>
