---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about, experience, site } from '../data/site';
---
<BaseLayout title="About">
  <div class="container page">
    <header class="page-header about-header">
      <div class="about-identity"><img src={site.avatar} alt="Ehsan Nasiri" /><div><span class="eyebrow">About · {about.years}</span><h1>Ehsan Nasiri · DeDeadend.</h1><p>{about.title}</p></div></div>
    </header>

    <section class="section prose">
      <span class="eyebrow">About me</span><h2>Android from the system layer up.</h2>
      <p>{site.bio}</p>
      <p>My work spans application development and the parts of Android that sit closer to the platform: Root, Shizuku, system customization, performance tuning, background behavior, and tools that need direct control over the device.</p>
      <p>I care about software that is fast, predictable, maintainable, and focused on solving a real problem rather than adding complexity for its own sake.</p>
    </section>

    <section class="section">
      <span class="eyebrow">Experience & activities</span><h2>What I've worked on.</h2>
      <div class="timeline">{experience.map((item) => <article class="timeline-item"><div class="timeline-dot"></div><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
    </section>

    <section class="section skills-section">
      <div><span class="eyebrow">Core stack</span><h2>Tools I use.</h2><div class="tags">{about.stack.map((item) => <span class="tag">{item}</span>)}</div></div>
      <div><span class="eyebrow">Architecture & concurrency</span><h2>How I build.</h2><div class="tags">{about.architecture.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section">
      <div class="split-section compact"><div><span class="eyebrow">System & performance</span><h2>Beyond standard Android.</h2></div><div class="tags">{about.system.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section contact-section">
      <span class="eyebrow">Connect</span><h2>Ehsan Nasiri · DeDeadend</h2>
      <p class="contact-email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="actions"><a class="button primary" href={site.github}>GitHub</a><a class="button" href={site.telegram}>Telegram</a></div>
    </section>
  </div>
</BaseLayout>
