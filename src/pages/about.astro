---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about, experience, site } from '../data/site';
---
<BaseLayout title="About">
  <div class="container page">
    <header class="page-header about-header">
      <span class="eyebrow">About · {about.years}</span>
      <h1>Ehsan Nasiri.</h1>
      <p>{about.title}</p>
    </header>

    <section class="section prose">
      <span class="eyebrow">About me</span><h2>Android development, from apps to system tools.</h2>
      <p>{site.bio}</p>
      <p>My work includes application development as well as parts of Android that sit closer to the platform: Root, Shizuku, system customization, performance, background behavior, and tools that need more direct access to the device.</p>
      <p>I generally prefer software that is straightforward to use, easy to maintain, and solves a specific problem without adding unnecessary complexity.</p>
    </section>

    <section class="section">
      <span class="eyebrow">Experience & activities</span><h2>Some things I've worked on.</h2>
      <div class="timeline">{experience.map((item) => <article class="timeline-item"><div class="timeline-dot"></div><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
    </section>

    <section class="section skills-section">
      <div><span class="eyebrow">Programming</span><h2>Languages.</h2><div class="tags">{about.programming.map((item) => <span class="tag">{item}</span>)}</div></div>
      <div><span class="eyebrow">Android development</span><h2>Platform & UI.</h2><div class="tags">{about.android.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section skills-section">
      <div><span class="eyebrow">Architecture & concurrency</span><h2>How I build.</h2><div class="tags">{about.architecture.map((item) => <span class="tag">{item}</span>)}</div></div>
      <div><span class="eyebrow">Data & tools</span><h2>Development stack.</h2><div class="tags">{about.data.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section">
      <div class="split-section compact"><div><span class="eyebrow">System & performance</span><h2>When the platform matters.</h2></div><div class="tags">{about.system.map((item) => <span class="tag">{item}</span>)}</div></div>
    </section>

    <section class="section contact-section">
      <span class="eyebrow">Connect</span><h2>Ehsan Nasiri.</h2>
      <p class="contact-email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="actions"><a class="button primary" href={site.github}>GitHub</a><a class="button" href={site.telegram}>Telegram</a></div>
    </section>
  </div>
</BaseLayout>
